# Copie este arquivo para .env e ajuste os valores: cp .env.example .env
# Nunca coloque segredos reais neste arquivo.

# Ambiente de execução (development | production)
NODE_ENV=development

# ---------- Backend ----------
# Porta em que a API escuta
BACKEND_PORT=3000
# Origem autorizada a chamar a API (URL do frontend)
CORS_ORIGIN=http://localhost:5173
# Pasta onde arquivos enviados são salvos localmente
UPLOAD_DIR=uploads

# ---------- Banco de dados (PostgreSQL) ----------
# Usadas pelo container do Postgres e pela conexão do backend
POSTGRES_USER=estoque
POSTGRES_PASSWORD=estoque_dev
POSTGRES_DB=estoque
# Fora do Docker o backend acessa o banco por localhost
# (no docker-compose o backend usa DB_HOST=db automaticamente)
DB_HOST=localhost
DB_PORT=5432

# ---------- Frontend ----------
# Porta do servidor de desenvolvimento do Vite
FRONTEND_PORT=5173
# URL da API usada pelo navegador (precisa do prefixo VITE_ para ser exposta)
VITE_API_URL=http://localhost:3000
